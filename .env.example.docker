# =========================
# Docker Compose environment
# =========================

# Bind published ports (secure-by-default)
BIND_IP=127.0.0.1

# Backend (container listens on 4000 internally)
PORT=4000
NODE_ENV=development

# Database (Docker service DNS)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydatabase

DATABASE_URL="postgresql://myuser:mysecretpassword@postgres:5432/mydatabase?schema=public"

# Nginx published ports (host -> container 80)
NGINX_HTTP_PORT=80
